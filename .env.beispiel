# ============================================================================
#  .env.beispiel — was der Server braucht
# ----------------------------------------------------------------------------
#  Diese Datei ist ein Beispiel und gehört ins Repository.
#  Die echte Datei heisst .env, steht in .gitignore und verlässt den
#  Rechner nie.
#
#  Die App selbst braucht nichts davon. Sie läuft ohne Server, ohne Konto
#  und ohne Schlüssel — das ist der Normalfall und bleibt es.
# ============================================================================

# --- Anmeldung über GitHub (freiwillig) -------------------------------------
# Anlegen unter github.com/settings/developers → New OAuth App.
# Rückrufadresse: <deine-adresse>/konto/oauth/github/zurueck
GITHUB_ID=
GITHUB_GEHEIM=

# --- Anmeldung über Google (freiwillig) -------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
GOOGLE_ID=
GOOGLE_GEHEIM=

# --- Die Adresse, unter der der Server läuft --------------------------------
# Wird für die Rückrufadressen gebraucht. Ohne Schrägstrich am Ende.
ADRESSE=https://redion.deine-adresse.workers.dev

# ============================================================================
#  Was hier NICHT hineingehört
# ----------------------------------------------------------------------------
#  Der Schlüssel für die KI. Der wird in Redion selbst eingetragen, liegt im
#  Browser und geht nur zum jeweiligen Anbieter. Ein Schlüssel in einer
#  Serverdatei wäre für alle Nutzer derselbe — und wer ihn einmal hat, hat
#  ihn für immer.
#
#  Der Satz für die Verschlüsselung. Der entsteht auf dem Gerät und darf
#  nirgendwo sonst stehen. Steht er auf dem Server, ist die Verschlüsselung
#  eine Behauptung.
# ============================================================================
