{
  // Kein Deployment ohne erneut geprüften Free-Tarif und echte Bindung.
  // Leere Adressen halten den Dienst geschlossen. Keine alten Datenbank-IDs.
  "name": "red-ion-mcp",
  "main": "../server/cloud-worker.mts",
  "compatibility_date": "2026-11-18",
  "send_metrics": false,
  "vars": {
    "MCP_ISSUER": "https://red-ion-mcp.redurbabat7.workers.dev",
    "MCP_AUTHORIZATION_ENDPOINT": "https://red-ion.redurbabat7.workers.dev/mcp/authorize",
    "MCP_FREE_ONLY": "1"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "redion",
    "database_id": "18b0f926-e522-4b77-8063-ca3399c478ae"
  }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
