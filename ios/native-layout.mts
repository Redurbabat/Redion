export function installIosSearchControls(doc: any): () => void {
  const win = doc?.defaultView;
  if (!doc?.body || !win?.MutationObserver || !win.matchMedia?.('(max-width:760px) and (pointer:coarse)').matches) return () => {};
  const decorate = () => {
    for (const finder of doc.querySelectorAll('.overlay .finder.such')) {
      const input = finder.querySelector('#q');
      if (!input || finder.querySelector('.redion-ios-search-heading')) continue;
      const heading = doc.createElement('div');
      heading.className = 'redion-ios-search-heading';
      const title = doc.createElement('strong');
      title.textContent = 'Suchen';
      const close = doc.createElement('button');
      close.type = 'button';
      close.className = 'redion-ios-search-close';
      close.textContent = 'Fertig';
      close.setAttribute('aria-label', 'Suche schliessen');
      // Use the existing Escape handler, including focus restoration and document search.
      close.addEventListener('click', () => input.dispatchEvent(new win.KeyboardEvent('keydown', {
        key: 'Escape', bubbles: true, cancelable: true
      })));
      input.setAttribute('aria-label', 'Suchen');
      input.setAttribute('enterkeyhint', 'search');
      heading.append(title, close);
      finder.insertBefore(heading, finder.firstChild);
    }
  };
  decorate();
  const observer = new win.MutationObserver(decorate);
  observer.observe(doc.body, {childList: true});
  return () => {
    observer.disconnect();
    doc.querySelectorAll('.redion-ios-search-heading').forEach((node: any) => node.remove());
  };
}
export function installIosNativeLayout(doc: any): () => void {
  if (!doc?.head || typeof doc.createElement !== 'function') return () => {};
  if (doc.getElementById?.(IOS_LAYOUT_STYLE_ID)) return () => {};
  const style = doc.createElement('style');
  style.id = IOS_LAYOUT_STYLE_ID;
  style.textContent = IOS_LAYOUT_CSS + IOS_PHONE_POLISH_CSS + IOS_DOCUMENT_POLISH_CSS + IOS_DRAWING_POLISH_CSS + IOS_LEARNING_POLISH_CSS;
  style.setAttribute?.('data-redion-native', 'layout');
  doc.head.appendChild(style);
  const stopSearch = installIosSearchControls(doc);
  return () => { stopSearch(); style.remove?.(); };
}
