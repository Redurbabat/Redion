/* Native iPhone-only CSS. Existing Redion Web/PWA/Windows UI remains identical. */
export const IOS_LAYOUT_STYLE_ID = 'redion-ios-layout-fixes-20261121';
export const IOS_LAYOUT_CSS = "\n/* RED ION - native iPhone-only layout corrections, existing routes unchanged. */\n@media screen and (max-width:760px) and (pointer:coarse) {\n  /* #main already reserves the status bar notch via --hoben. */\n  #main > #topbar {\n    box-sizing:border-box;\n    height:50px;\n    flex:0 0 50px;\n    padding-top:0;\n    padding-bottom:0;\n    padding-left:max(6px,env(safe-area-inset-left,0px));\n    padding-right:max(6px,env(safe-area-inset-right,0px));\n    align-items:center;\n  }\n  #topbar .top-btn {min-width:44px;min-height:44px;height:44px}\n  #topbar #crumb {min-width:0;font-size:14px;font-weight:560;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  #scroll {-webkit-overflow-scrolling:touch;scroll-padding-block-end:calc(var(--hunten,70px) + 20px)}\n\n  /* Document library: one hierarchy of search, create and import actions. */\n  .bib[data-bib-bereich] {padding-top:8px}\n  .bib[data-bib-bereich] .bib-dkopf {row-gap:12px;margin-bottom:16px}\n  .bib[data-bib-bereich] .bib-dkopf h1 {font-size:clamp(29px,7.5vw,34px);line-height:1.12;letter-spacing:-.032em}\n  .bib[data-bib-bereich] .bib-workspace-eyebrow {margin-bottom:3px;font-size:12px}\n  .bib-workspace-actions {gap:8px}\n  .bib-workspace-actions :is(.bib-search,.bib-neu,.bib-studio-import) {\n    min-height:44px;border-radius:13px;box-shadow:none;font-weight:600;\n  }\n  .bib-workspace-actions .bib-studio-import {\n    border:1px solid var(--line);\n    background:var(--bg-hover);\n    color:var(--text);\n  }\n  .bib[data-bib-bereich] .bib-wahl {padding-top:12px;gap:8px}\n  .bib[data-bib-bereich] .bib-pille {min-height:44px;border-radius:13px}\n  .bib[data-bib-bereich] .bib-ablage-baum-kopf {min-height:44px;font-size:14px}\n  .bib[data-bib-bereich] .bib-gitter {gap:12px}\n  .bib[data-bib-bereich] .bib-deckel {border-radius:16px;box-shadow:none}\n\n  /* Today and learning: keep the real study actions before decoration. */\n  .lernwelt .lw-next-step {gap:12px;padding:14px 0;margin-bottom:16px;border-top:0}\n  .lernwelt .lw-next-step h2 {font-size:22px;line-height:1.2;letter-spacing:-.025em}\n  .lernwelt .lw-next-step > div > p {margin-bottom:4px;font-size:12px}\n  .lernwelt .lw-next-step .lw-actions {width:100%;gap:8px}\n  .lernwelt .lw-next-step .lw-actions button {min-height:44px;border-radius:13px}\n  .lernwelt .lw-desk {padding:18px 16px;gap:12px;border-radius:20px}\n  .lernwelt .lw-desk h2 {font-size:clamp(25px,6.5vw,29px);line-height:1.17;letter-spacing:-.035em}\n  .lernwelt .lw-desk .lw-actions button {min-height:44px;border-radius:13px}\n  .lernwelt .lw-page-head {padding:12px 8px 14px;gap:10px}\n  .lernwelt .lw-page-head h2 {font-size:clamp(24px,6.5vw,30px);line-height:1.13}\n  .lernwelt .lw-page-head > div:first-child > span {font-size:14px;line-height:1.45}\n  .lernwelt .lw-metrik {min-height:80px;padding:12px}\n  .lernwelt .lw-study-actions article {min-height:0;padding:14px;border-radius:16px}\n\n  /* Termine and start: all three actions should have readable full names. */\n  .home {padding-top:10px;padding-bottom:16px}\n  .home h1 {font-size:clamp(30px,8vw,35px);line-height:1.09;letter-spacing:-.035em;margin-bottom:20px}\n  .home h2 {font-size:14px;margin:22px 0 8px}\n  .home-karten {grid-template-columns:minmax(0,1fr);gap:10px}\n  .home-karten .hk {min-height:76px;padding:14px 17px;gap:4px;border-radius:16px;background:var(--bg-card);box-shadow:none}\n  .home-karten .hk b {font-size:17px;line-height:1.25}\n  .home-karten .hk span {font-size:13px;line-height:1.38}\n  .home-liste button {min-height:50px;border-radius:12px;font-size:15px;line-height:1.35}\n\n  /* More and settings: consistently large touch targets. */\n  .einst-nav button,.menu.blatt button {min-height:50px}\n  .menu.blatt button {line-height:1.32}\n  .overlay .finder {\n    max-height:calc(100dvh - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px) - 12px);\n  }\n  :where(.home,.lernwelt,.bib[data-bib-bereich]) :is(button,a[href],summary):focus-visible {\n    outline:2px solid var(--accent-text);outline-offset:3px;\n  }\n}\n@media screen and (max-width:470px) and (pointer:coarse) {\n  /* Document shortcut remains tappable; only its oversized decoration shrinks. */\n  .lernwelt .lw-paper-stack {width:min(150px,42vw);padding:6px}\n  .lernwelt .lw-paper-sheet {min-height:160px;padding:12px}\n  .lernwelt .lw-paper-preview {max-height:36px;margin:8px 0}\n  .lernwelt .lw-paper-cap,.lernwelt .lw-paper-foot {margin-bottom:8px;padding-top:8px}\n  .lernwelt .lw-paper-sheet > strong {font-size:14px}\n}\n@media (prefers-reduced-motion:reduce) {\n  .home-karten .hk,.bib[data-bib-bereich] .bib-deckel {transition:none;animation:none}\n}\n";
export function installIosNativeLayout(doc: any): () => void {
  if (!doc?.head || typeof doc.createElement !== 'function') return () => {};
  if (doc.getElementById?.(IOS_LAYOUT_STYLE_ID)) return () => {};
  const style = doc.createElement('style');
  style.id = IOS_LAYOUT_STYLE_ID;
  style.textContent = IOS_LAYOUT_CSS;
  style.setAttribute?.('data-redion-native', 'layout');
  doc.head.appendChild(style);
  return () => style.remove?.();
}
