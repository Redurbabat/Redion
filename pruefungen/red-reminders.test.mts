import test from 'node:test';
import assert from 'node:assert/strict';
import {mkdtemp,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {openHomeServer} from '../server/home-server.ts';
import {approveHomeDevice} from '../server/home/pairing.ts';
import {createRedReminders} from '../server/home/reminders.ts';
import {createRedPairProof,type RedSession} from '../red-sdk/client.mts';
const DAY=86400000;
type Rule={id:string;kind:string;period:string;firstDue:number;nextDue:number|null;pendingDue:number|null;lastAck:number|null;review?:{due:number;measuredAt:number;status:string;result:unknown}|null};
test('maintenance automation is scoped, persistent, idempotent and coalesces missed repeats',async()=>{
 const root=await mkdtemp(join(tmpdir(),'red-reminder-')),origin='https://home.example.test';
 let s=await openHomeServer({dataDir:root,origin,webOrigins:'https://web.example.test'});
 try{
  const req=(path:string,body?:object,token?:string,from?:string)=>new Request(origin+path,{method:body?'POST':'GET',headers:{...(body?{'Content-Type':'application/json'}:{}),...(token?{Authorization:'Bearer '+token}:{}),...(from?{Origin:from}:{})},...(body?{body:JSON.stringify(body)}:{})});
  const {code}=await (await s.handle(req('/konto/code',{geraet:'Owner'}))).json() as {code:string};
  approveHomeDevice(s.store.sqlite,code);
  const {token}=await (await s.handle(req('/konto/code-holen',{code}))).json() as {token:string};
  const proof=await createRedPairProof();
  await s.handle(req('/red-id/v2/approve-login',{app:'red-fit',challenge:proof.challenge},token));
  const session=await (await s.handle(req('/red-id/v2/claim-login',{app:'red-fit',verifier:proof.verifier}))).json() as RedSession;
  const prefix='/home/reminders/',id='a'.repeat(32),once='b'.repeat(32),start=Date.now();
  let now=start;
  let handler=createRedReminders(s.store.sqlite,s.store.ablage,()=>now);
  const call=(action:string,body?:object)=>handler(req(prefix+action,body,token));
  const rules=async(action:'poll'|'list')=>(await (await call(action,action==='poll'?{}:undefined)).json() as {rules:Rule[]}).rules;
  assert.equal((await s.handle(req(prefix+'list'))).status,401);
  assert.equal((await s.handle(req(prefix+'list',undefined,session.accessToken))).status,401);
  assert.equal((await s.handle(req(prefix+'list',undefined,token,'https://web.example.test'))).status,403);
  const payload={id,kind:'backup-review',period:'daily',firstDue:start+1000};
  assert.equal((await call('create',payload)).status,201);
  assert.equal((await call('create',payload)).status,200);
  assert.equal((await call('create',{...payload,period:'weekly'})).status,409);
  assert.equal((await call('create',{...payload,id:once,period:'once',kind:'grant-review'})).status,201);
  assert.equal((await call('create',{...payload,id:'c'.repeat(32),command:'backup'})).status,400);
  assert.equal((await rules('poll'))[0]?.pendingDue,null);
  now=start+3*DAY+1000;
  assert.equal((await rules('list')).find(r=>r.id===id)?.pendingDue,null);
  const polled=(await rules('poll')).find(r=>r.id===id)!;
  assert.equal(polled.pendingDue,now);assert.equal(polled.nextDue,now+DAY);
  const one=(await rules('poll')).find(r=>r.id===once)!;
  assert.equal(one.pendingDue,start+1000);assert.equal(one.nextDue,null);
  now+=2*DAY;
  assert.equal((await rules('poll')).find(r=>r.id===id)?.pendingDue,polled.pendingDue);
  assert.equal((await call('ack',{id,due:now})).status,409);
  assert.equal((await call('ack',{id,due:polled.pendingDue})).status,200);
  assert.equal((await call('ack',{id,due:polled.pendingDue})).status,200);
  s.close();s=await openHomeServer({dataDir:root,origin,webOrigins:'https://web.example.test'});
  handler=createRedReminders(s.store.sqlite,s.store.ablage,()=>now);
  assert.equal((await rules('list')).find(r=>r.id===once)?.pendingDue,start+1000);
  assert.equal((await rules('list')).find(r=>r.id===id)?.lastAck,polled.pendingDue);
  assert.equal((await s.handle(req(prefix+'list',undefined,token))).status,200);
  now+=DAY;
  assert.equal((await rules('poll')).find(r=>r.id===id)?.pendingDue,now);
  assert.equal((await call('cancel',{id})).status,200);
  assert.equal((await call('cancel',{id})).status,200);
  assert.equal((await rules('list')).length,1);
 }finally{s.close();await rm(root,{recursive:true,force:true});}
});

test('opt-in server lifecycle catches up stored reminders without polling',async()=>{
 const root=await mkdtemp(join(tmpdir(),'red-reminder-lifecycle-')),origin='https://home.example.test';
 let s=await openHomeServer({dataDir:root,origin});
 try{
  const call=(path:string,body?:object,token?:string)=>s.handle(new Request(origin+path,{method:body?'POST':'GET',headers:{...(body?{'Content-Type':'application/json'}:{}),...(token?{Authorization:'Bearer '+token}:{})},...(body?{body:JSON.stringify(body)}:{})}));
  const {code}=await (await call('/konto/code',{geraet:'Owner'})).json() as {code:string};
  approveHomeDevice(s.store.sqlite,code);
  const {token}=await (await call('/konto/code-holen',{code})).json() as {token:string};
  const firstDue=Date.now()-1000,id='d'.repeat(32);
  assert.equal((await call('/home/reminders/create',{id,kind:'storage-review',period:'once',firstDue},token)).status,201);
  const list=async()=>(await (await call('/home/reminders/list',undefined,token)).json() as {rules:Rule[]}).rules.find(r=>r.id===id);
  assert.equal((await list())?.pendingDue,null);
  s.close();s=await openHomeServer({dataDir:root,origin,enableReminderScheduler:true});
  assert.equal((await list())?.pendingDue,firstDue);
  const review=(await list())?.review;
  assert.equal(review?.due,firstDue);assert.ok(['ok','warning','critical'].includes(review?.status??''));
  assert.equal((await list())?.nextDue,null);
  assert.equal((await call('/home/reminders/ack',{id,due:firstDue},token)).status,200);
  assert.equal((await list())?.pendingDue,null);
  assert.deepEqual((await list())?.review,review);
  assert.equal((await call('/home/reminders/cancel',{id},token)).status,200);
  assert.equal((await list()),undefined);
  assert.equal(s.store.sqlite.prepare('SELECT count(*) AS n FROM home_red_maintenance_review').get()?.n,0);
 }finally{s.close();await rm(root,{recursive:true,force:true});}
});
