import {chromium} from 'playwright';
import fs from 'node:fs';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
import assert from 'node:assert/strict';
const root=path.resolve(import.meta.dirname,'..'),output=path.join(root,'bilder/glass-wheel');
fs.mkdirSync(output,{recursive:true});
const browser=await chromium.launch();
try{
 for(const [width,height] of [[390,844],[430,932],[1366,768],[1440,900]])for(const dark of [false,true]){
  const context=await browser.newContext({viewport:{width:width!,height:height!},hasTouch:width!<761,isMobile:width!<761});
  const page=await context.newPage();page.setDefaultTimeout(15000);
  const errors:string[]=[];page.on('pageerror',error=>errors.push(error.message));
  await page.goto(pathToFileURL(path.join(root,'index.html')).href);
  await page.waitForFunction("typeof GlassWheel!=='undefined' && !!document.body.dataset.studioNav");
  await page.waitForTimeout(600);
  assert.equal(await page.evaluate('GlassWheel.mode()'),'classic','Ohne Wahl bleibt Klassisch aktiv');
  const ids=await page.evaluate(`(async()=>{
    Store.setMeta('rundgangGesehen',true);Store.setMeta('neuerungenGesehen',Math.max(...Rundgang.NEUERUNGEN.map(n=>n.nr)));
    document.querySelectorAll('.overlay,.produkt-onboarding-lage,#rg-willkommen,#rg-einladung,#rg-neu').forEach(node=>node.remove());
    App.theme('${dark?'dark':'light'}');
    const a=Lebensbereiche.anlegen({name:'Studium',art:'uni'}),b=Lebensbereiche.anlegen({name:'Arbeit',art:'arbeit'});
    Lebensbereiche.anlegen({name:'Privat',art:'privat'});
    const note=Store.addPage(null,{text:'Lernnotizen'}),pdf=Store.addPage(null,{text:'Mathe.pdf',dokumentModus:true});
    Store.addBlock(note.id,'text',{text:'Meine Gedanken gehören weiterhin zu derselben Notiz.'});
    Store.addBlock(pdf.id,'pdfseite',{bw:595,bh:842,nr:1,suchtext:'Prüfdokument',marken:[]});
    const db=Store.addPage(null,{text:'Stundenplan'});Store.addDatabase(db.id,'Kurse',{title:{type:'title',name:'Kurs'}});
    const unassigned=Store.addPage(null,{text:'Ohne Bereich'});
    await Lebensbereiche.zuordnen({art:'page',id:note.id},a.id);
    await Lebensbereiche.zuordnen({art:'page',id:note.id},b.id);
    await Lebensbereiche.zuordnen({art:'page',id:pdf.id},a.id);
    await Lebensbereiche.zuordnen({art:'page',id:db.id},b.id);
    App.oeffne(note.id);for(let i=Fenster.reiter().length-1;i>=0;i--)if(Fenster.reiter()[i].id!==note.id)Fenster.schliessen(i);
    Fenster.neuerReiter(pdf.id);Fenster.neuerReiter(db.id);Fenster.neuerReiter(unassigned.id);
    await Store.flush();Bibliothek.oeffne('');
    document.getElementById('toast')?.classList.remove('show');document.querySelectorAll('#ru-toast-stapel .ru-toast-alt').forEach(node=>node.remove());
    return {a:a.id,b:b.id,note:note.id,pdf:pdf.id,db:db.id,unassigned:unassigned.id};
  })()`) as {a:string;b:string;note:string;pdf:string;db:string;unassigned:string};
  await page.screenshot({path:path.join(output,`${width}-${dark?'dunkel':'hell'}-klassisch.png`)});
  await page.evaluate('Aussehen.dialog()');
  await page.waitForSelector('[data-gw-mode="glass-wheel"]');
  await page.screenshot({path:path.join(output,`${width}-${dark?'dunkel':'hell'}-aussehen.png`)});
  const before=await page.evaluate(`JSON.stringify({blocks:Store.cache.blocks,collections:Store.cache.collections,reiter:Store.getMeta('reiter'),aussehen:Store.getMeta('aussehen')})`);
  await page.locator('[data-gw-mode="glass-wheel"]').click();
  await page.locator('.overlay [data-a="zu"]').first().click();
  await page.evaluate(`GlassWheel.select(Lebensbereiche.auflisten().findIndex(area=>area.id==='${ids.a}')); GlassWheel.refresh()`);
  await page.waitForFunction(()=>document.querySelectorAll('.gw-tab-card').length===2);
  assert.equal(await page.locator('#handy-oben').count(),1,'Ein Dock, kein Nachbau');
  const layout=await page.locator('#glass-wheel-shell').boundingBox();
  assert.ok(layout&&layout.width>width!*.5,'Das Rad belegt die Inhaltsbühne, keine versehentliche schmale Grid-Zelle');
  assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false,'Kein Seitenüberlauf');
  await page.waitForTimeout(500);
  await page.screenshot({path:path.join(output,`${width}-${dark?'dunkel':'hell'}-glass-wheel.png`)});
  for(let i=0;i<100;i++)await page.evaluate('GlassWheel.setMode("classic");GlassWheel.setMode("glass-wheel")');
  assert.equal(await page.locator('#glass-wheel-shell').count(),1);
  assert.equal(await page.evaluate(`JSON.stringify({blocks:Store.cache.blocks,collections:Store.cache.collections,reiter:Store.getMeta('reiter'),aussehen:Store.getMeta('aussehen')})`),before,'100 Wechsel verändern keine Inhalte/Reiter/Farben');
  await page.locator('.gw-wheel').focus();await page.keyboard.press('ArrowRight');
  await page.waitForTimeout(150);
  assert.ok(await page.locator('.gw-area[aria-pressed="true"]').count());
  await page.locator('.gw-tray-heading button').filter({hasText:'Alle geöffnet'}).click();
  await page.waitForFunction(()=>document.querySelectorAll('.gw-tab-card').length===4);
  assert.ok((await page.locator('.gw-open-list').textContent())?.includes('Ohne Bereich'));
  await page.locator('.gw-tab-open').filter({hasText:'Lernnotizen'}).click();
  await page.waitForFunction(id=>document.querySelector('#title')?.textContent==='Lernnotizen'&&!!id,ids.note);
  await page.screenshot({path:path.join(output,`${width}-${dark?'dunkel':'hell'}-editor.png`)});
  await page.locator('.gw-classic-return').click();
  assert.equal(await page.locator('#glass-wheel-shell').count(),0);
  assert.equal(await page.evaluate('GlassWheel.mode()'),'classic');
  assert.deepEqual(errors,[]);
  console.log(`✓ ${width}×${height} ${dark?'dunkel':'hell'}: Klassisch, Wahl, Rad, echte Tabs, 100 Wechsel und Editor`);
  await context.close();
 }
}finally{await browser.close();}
