{
  "name": "redion",
  "version": "2026.8.3",
  "description": "Redion — Notizen, Datenbanken und Formeln, die auf dem eigenen Gerät liegen",
  "private": true,
  "type": "module",
  "scripts": {
    "bauen": "node bauen.mts",
    "pruefen": "node pruefungen/alle.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "bauen:ts": "tsc -p tsconfig.bauen.json && tsc -p tsconfig.sw.json",
    "server": "node server/pruefserver.ts 8790",
    "veroeffentlichen": "npx wrangler deploy",
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest run"
  },
  "keywords": [
    "notizen",
    "datenbank",
    "formeln",
    "local-first",
    "offline"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  }
}
