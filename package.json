{
  "name": "redion",
  "version": "2026.8.3",
  "description": "Redion — Notizen, Datenbanken und Formeln, die auf dem eigenen Gerät liegen",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "bauen": "node bauen.mts",
    "pruefen": "node pruefungen/alle.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.islands.json",
    "bauen:inseln": "node bauen-inseln.mts",
    "bauen:ts": "node bauen-inseln.mts && tsc -p tsconfig.bauen.json && node dienststand.mts && tsc -p tsconfig.stand.json && tsc -p tsconfig.sw.json",
    "stand": "node dienststand.mts --pruefen",
    "server": "node server/pruefserver.ts 8790",
    "veroeffentlichen": "npx wrangler deploy",
    "sync:check": "node tools/sync-readiness.mjs",
    "test:sync-readiness": "node --test tools/sync-readiness.test.mjs"
  },
  "keywords": [
    "notizen",
    "datenbank",
    "formeln",
    "local-first",
    "offline"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "^1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
