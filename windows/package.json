{
  "name": "redion-windows",
  "version": "2026.8.4",
  "private": true,
  "description": "Redion für Windows – vollständig offline",
  "main": "main.cjs",
  "author": "Redion",
  "scripts": {
    "prepare:app": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node prepare.mjs",
    "start": "node live.mts",
    "test": "node --test windows-desktop.test.cjs auto-update.test.cjs live.test.mts local-source.test.mts version.test.mts",
    "dist": "npm run prepare:app && electron-builder --win nsis portable --x64",
    "release:signed": "npm run prepare:app && node release-signed.mjs",
    "start:once": "npm run prepare:app && electron .",
    "dist:mac": "npm run prepare:app && electron-builder --mac dmg zip --arm64 --config.directories.output=../build/macos-dist",
    "test:mac": "node --test macos-desktop.test.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ch.redurbabat.redion.windows",
    "productName": "Redion",
    "asar": true,
    "files": [
      "main.cjs",
      "paths.cjs",
      "auto-update.cjs",
      "update-policy.cjs",
      "generated/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/windows-app",
        "to": "redion-web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "../build/windows-dist"
    },
    "win": {
      "fileAssociations": [
        {
          "ext": "redion",
          "name": "Redion-Sicherung",
          "role": "Editor"
        },
        {
          "ext": "pdf",
          "name": "PDF-Dokument",
          "role": "Viewer"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../oeffentlich/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "appId": "ch.redurbabat.redion.macos",
      "category": "public.app-category.productivity",
      "icon": "../oeffentlich/icons/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "js-yaml": "4.1.0"
  }
}
